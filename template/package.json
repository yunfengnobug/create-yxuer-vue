{
  "name": "yxuer-pc-vue",
  "version": "1.1.0",
  "private": true,
  "author": "王俊杰 <1768669274@qq.com>",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:local": "npx only-allow pnpm && vite --mode devlocal",
    "dev:master": "npx only-allow pnpm && vite --mode devmaster",
    "dev:tencentCloud": "npx only-allow pnpm && vite --mode devtencentCloud",
    "build:master": "npx --yes only-allow pnpm && vite build --mode prodmaster",
    "build:tencentCloud": "npx --yes only-allow pnpm && vite build --mode prodtencentCloud",
    "report:master": "npx only-allow pnpm && rimraf dist && cross-env ANALYZE=true vite build --mode prodmaster",
    "report:tencentCloud": "npx only-allow pnpm && rimraf dist && cross-env ANALYZE=true vite build --mode prodtencentCloud",
    "format": "oxfmt --write src/",
    "lint": "oxlint --fix src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "aieditor": "^1.4.2",
    "ant-design-vue": "~4.2.6",
    "axios": "^1.13.5",
    "dayjs": "^1.11.19",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.3.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.0",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,css,scss,json,jsonc}": [
      "oxfmt src/",
      "oxlint src/"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=10",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@10.30.2",
  "email": "1768669274@qq.com"
}
